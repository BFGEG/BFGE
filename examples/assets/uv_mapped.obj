# Material library reference (optional)
mtllib example.mtl

# List of geometric vertices (X, Y, Z)
v -0.500000 -0.500000 0.000000
v  0.500000 -0.500000 0.000000
v  0.500000  0.500000 0.000000
v -0.500000  0.500000 0.000000

# List of texture coordinates (U, V values from 0.0 to 1.0)
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

# List of vertex normals (X, Y, Z)
vn 0.000000 0.000000 1.000000

# Group or Object name
usemtl DefaultMaterial
s off

# Faces defined as: f vertex/texture/normal  vertex/texture/normal  vertex/texture/normal
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
